        <meta charset="UTF-8"/>
        <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
        <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
        <title>NexusPIPE | Security Check</title>
        <meta name="description" content="We're doing a security check - this should only take a few seconds..."/>
        <style>
            @keyframes b {
                0% {
                    transform: scale(1);
                }

                50% {
                    transform: scale(0.8);
                }

                100% {
                    transform: scale(1);
                }
            }

            html,body {
                background: #262832;
                color: #fff;
                background-repeat: no-repeat;
                background-size: cover;
                background-position: center;
                height: 100%;
                width: 100%;
                display: flex;
                text-align: center;
                font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI',
                    Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue',
                    sans-serif;
                overflow-x: hidden;
                margin: 0;
            }

            a {
                color: #ffa820;
            }

            .ring {
                animation: b 2s infinite;
            }

            #dots {
                position: absolute;
            }

            footer p {
                opacity: 0.8;
                transition: opacity 1s;
            }

            footer p:hover {
                opacity: 1;
            }

            main .content #captcha {
                margin: 1rem auto;
                background: #40424c;
                padding: 10px;
                border-radius: 5px;
                text-align: center;
                width: 350px;
            }

            main .content #captcha span {
                font-size: 18px;
                font-weight: 400;
                margin: 1rem 0;
                display: block;
            }

            main .content #captcha span em.underlined {
                text-decoration: underline;
                font-style: normal;
            }

            .sliding {
                position: absolute;
                z-index: 10;
                filter: drop-shadow(2px 2px 1px rgba(255, 255, 255, 1)) drop-shadow(-2px -2px 1px rgba(255, 255, 255, 1));
                -webkit-transform: translate3d(0, 0, 0);
            }

            .slider {
                -webkit-appearance: none;
                width: 100%;
                height: 25px;
                background: #2a2c33;
                outline: none;
                -webkit-transition: 0.2s;
                transition: opacity 0.2s;
                margin: 0;
                margin-top: 1rem;
                border-radius: 5px;
            }

            .slider::-webkit-slider-thumb {
                -webkit-appearance: none;
                appearance: none;
                background: #ffa820;
                padding: 1rem;
                cursor: pointer;
                width: 3rem;
                height: 2rem;
                background: #ffb136;
                border-radius: 10px;
                border: none;
                cursor: pointer;
            }

            .slider::-moz-range-thumb {
                width: 3rem;
                height: 2rem;
                background: #ffb136;
                border-radius: 10px;
                border: none;
                cursor: pointer;
            }

            .slider::-moz-range-thumb:active {
                transform: scale(1.1);
            }

            .slider::-webkit-slider-thumb:active {
                transform: scale(1.1);
            }

            main {
                padding: 5% 20%;
                box-sizing: border-box;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                width: 100%;
                text-align: left;
                flex-grow: 1;
            }

            main h1 {
                width: 100%;
                color: #ffb136;
                font-size: 3rem;
                margin: 0;
            }

            main h2 {
                font-size: 2rem;
                font-weight: 500;
                text-align: left;
                width: 100%;
                word-wrap: break-word;
            }

            main .content {
                display: grid;
                grid-template-columns: auto auto;
                gap: 2rem;
                margin: 2rem 0;
            }

            main .content .text h3 {
                font-size: 2rem;
                color: #ffb136;
            }

            main .content .text p {
                font-weight: 500;
                line-height: 1.5;
            }

            main .content #captcha {
                margin-right: auto;
                border-top-color: #ffb24c;
                border-top-width: 5px;
                border-top-style: outset;
                border-radius: 10px 10px 10px 10px;
                height: fit-content;
            }

            main .content #captcha #stuff {
                position: relative;
            }

            main .content #captcha #stuff img {
                width: 100%;
                border-radius: 5px;
            }

            main .content #captcha .footer {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-top: 1rem;
            }

            main .content #captcha .footer a {
                text-decoration: none;
                color: white;
            }

            main .content #captcha .footer span {
                display: flex;
                align-items: center;
                margin: 0;
                gap: 0.5rem;
                font-size: 0.9rem;
            }

            main .content #captcha .footer img {
                width: 1.5rem;
            }

            svg {
                width: 1.2rem;
                fill: #feb036;
            }

            body>.footer {
                background: #191b20;
                width: 100%;
                padding: 1rem;
                box-sizing: border-box;
                display: flex;
                justify-content: space-between;
                align-items: center;
                position: fixed;
                bottom: 0;
            }

            body>.footer img {
                width: 8rem;
            }

            body>.footer a {
                text-decoration: none;
                color: white;
            }

            body>.footer a span {
                display: flex;
                align-items: center;
            }

            body>.footer a span svg {
                margin-right: 0.5rem;
            }

            @media screen and (max-width: 1400px) {
                body {
                    display: block;
                    height: max-content;
                }

                main .content {
                    display: block;
                }
            }

            @media screen and (max-width: 800px) {
                body {
                    display: block;
                    height: max-content;
                }

                main {
                    padding: 5%;
                    height: max-content;
                    display: block;
                }

                main .content {
                    display: block;
                }
            }

            .lds-ellipsis {
                display: inline-block;
                position: relative;
                width: 80px;
                height: 80px;
            }

            .lds-ellipsis div {
                position: absolute;
                top: 33px;
                width: 13px;
                height: 13px;
                border-radius: 50%;
                background: #ffb136;
                animation-timing-function: cubic-bezier(0, 1, 1, 0);
            }

            .lds-ellipsis div:nth-child(1) {
                left: 8px;
                animation: lds-ellipsis1 0.6s infinite;
            }

            .lds-ellipsis div:nth-child(2) {
                left: 8px;
                animation: lds-ellipsis2 0.6s infinite;
            }

            .lds-ellipsis div:nth-child(3) {
                left: 32px;
                animation: lds-ellipsis2 0.6s infinite;
            }

            .lds-ellipsis div:nth-child(4) {
                left: 56px;
                animation: lds-ellipsis3 0.6s infinite;
            }

            @keyframes lds-ellipsis1 {
                0% {
                    transform: scale(0);
                }

                100% {
                    transform: scale(1);
                }
            }

            @keyframes lds-ellipsis3 {
                0% {
                    transform: scale(1);
                }

                100% {
                    transform: scale(0);
                }
            }

            @keyframes lds-ellipsis2 {
                0% {
                    transform: translate(0, 0);
                }

                100% {
                    transform: translate(24px, 0);
                }
            }
        </style>
    </head>
    <body id="body">
        <main id="main_loading">
            <div class="lds-ellipsis">
                <div></div>
                <div></div>
                <div></div>
                <div></div>
            </div>
        </main>
        <main id="main_captcha" style="display: none;">
            <h1>Whoa there!</h1>
            <h2 id="domainMessage1">Please complete the security check to access </h2>
            <div class="content">
